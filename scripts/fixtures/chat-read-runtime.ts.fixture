import { v } from "convex/values";
import { mutation, query } from "./_generated/server";
export const seed = mutation({ args: {}, handler: async ctx => {
  const now = Date.now(), accountId = await ctx.db.insert("accounts", { email: "chat-read@example.invalid", createdAt: now });
  await ctx.db.insert("sessions", { accountId, token: "synthetic-chat-owner", expiresAt: now + 3600000 });
  const threadId = await ctx.db.insert("chat_threads", { accountId, unreadOwner: 2, unreadRenter: 2, escalated: false, updatedAt: now });
  const bookingId = await ctx.db.insert("bookings", { accountId, status: "confirmed", lineItems: [], fulfilment: "pickup", deliveryFee: 0, subtotal: 0, discount: 0, depositAmount: 0, total: 0, currency: "GBP" });
  return { accountId, threadId, bookingId };
} });
export const message = mutation({ args: { accountId: v.id("accounts"), sender: v.union(v.literal("renter"), v.literal("owner")), at: v.number() }, handler: async (ctx, args) => ctx.db.insert("messages", { ...args, text: "Synthetic message" }) });
export const thread = query({ args: { threadId: v.id("chat_threads") }, handler: async (ctx, { threadId }) => ctx.db.get(threadId) });
export const linkedEmailReadState = mutation({ args: { accountId: v.id("accounts"), bookingId: v.id("bookings") }, handler: async (ctx, { accountId, bookingId }) => {
  const now = Date.now();
  await ctx.db.insert("chat_threads", { accountId, bookingId, unreadOwner: 0, unreadRenter: 0, escalated: false, updatedAt: now });
  async function createLinkedEmail(targetAccountId: any, targetBookingId: any, at: number) {
    const emailThreadId = await ctx.db.insert("email_threads", { accountId: targetAccountId, bookingId: targetBookingId, email: "renter@example.invalid", subject: "Rental question", status: "open", createdAt: at, updatedAt: at, lastAt: at, lastDirection: "in", lastText: "Rental question", unreadOwner: 2 });
    const emailMessageId = await ctx.db.insert("email_messages", { threadId: emailThreadId, bookingId: targetBookingId, direction: "in", sender: "renter@example.invalid", recipient: "rentals@example.invalid", subject: "Rental question", text: "Rental question", at, state: "received", humanRequested: false });
    const profileMessageId = await ctx.db.insert("messages", { accountId: targetAccountId, bookingId: targetBookingId, sender: "renter", text: "Rental question", at, meta: { channel: "email", emailThreadId: String(emailThreadId), emailMessageId: String(emailMessageId) } });
    await ctx.db.patch(emailMessageId, { profileMessageId });
    await ctx.db.patch(emailThreadId, { latestInboundMessageId: emailMessageId });
    return { emailThreadId, profileMessageId };
  }
  const read = await createLinkedEmail(accountId, bookingId, now - 100);
  const newer = await createLinkedEmail(accountId, bookingId, now + 1000);
  const general = await createLinkedEmail(accountId, undefined, now - 200);
  const otherBookingId = await ctx.db.insert("bookings", { accountId, status: "confirmed", lineItems: [], fulfilment: "pickup", deliveryFee: 0, subtotal: 0, discount: 0, depositAmount: 0, total: 0, currency: "GBP" });
  const otherBooking = await createLinkedEmail(accountId, otherBookingId, now - 300);
  const otherAccountId = await ctx.db.insert("accounts", { email: "other@example.invalid", createdAt: now });
  const otherAccount = await createLinkedEmail(otherAccountId, bookingId, now - 400);
  return { read, newer, general, otherBooking, otherAccount };
} });
export const emailReadStates = query({ args: { threadIds: v.array(v.id("email_threads")) }, handler: async (ctx, { threadIds }) => Promise.all(threadIds.map(async threadId => (await ctx.db.get(threadId))?.unreadOwner)) });
export const alerts = mutation({ args: { accountId: v.id("accounts"), older: v.id("messages"), newer: v.id("messages") }, handler: async (ctx, { accountId, older, newer }) => {
  const now = Date.now();
  for (const messageId of [newer, older]) for (let index = 0; index < 125; index++)
    await ctx.db.insert("admin_notifications", { eventKey: `renter-message:${messageId}`, kind: "renter_message", accountId, title: "Test", body: "Test", createdAt: now, read: false });
  await ctx.db.insert("admin_notifications", { eventKey: "historical-handoff", kind: "human_request", accountId, title: "Test", body: "Test", createdAt: now - 10000, read: false });
  await ctx.db.insert("admin_notifications", { eventKey: "uncertain-handoff", kind: "human_request", accountId, title: "Test", body: "Test", createdAt: now + 1, read: false });
  await ctx.db.insert("admin_notifications", { eventKey: "verification-alert", kind: "verification_failure", accountId, title: "Test", body: "Test", createdAt: now - 10000, read: false });
} });
export const notifications = query({ args: {}, handler: async ctx => await ctx.db.query("admin_notifications").collect() });
export const advanceThread = mutation({ args: { threadId: v.id("chat_threads"), at: v.number() }, handler: async (ctx, { threadId, at }) => ctx.db.patch(threadId, { updatedAt: at }) });
