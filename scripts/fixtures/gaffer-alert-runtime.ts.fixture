import { action, internalMutation, mutation, query } from "./_generated/server";
import { internal } from "./_generated/api";
import { v } from "convex/values";
import { postRentalMessage } from "./lib/rentalChat";

export const seed=mutation({args:{},handler:async ctx=>{const accountId=await ctx.db.insert("accounts",{email:"gaffer-synthetic@example.invalid",createdAt:Date.now()});await ctx.db.insert("sessions",{token:"synthetic-renter",accountId,expiresAt:Date.now()+3600000});const bookingId=await ctx.db.insert("bookings",{accountId,status:"confirmed",fulfilment:"pickup",deliveryFee:0,subtotal:0,discount:0,total:0,currency:"GBP",depositAmount:0,lineItems:[]});return {accountId,bookingId};}});
export const answer=action({args:{accountId:v.id("accounts"),bookingId:v.id("bookings"),replyTo:v.id("messages"),handoff:v.optional(v.boolean()),answerComplete:v.optional(v.boolean()),offerHuman:v.optional(v.boolean())},handler:async(ctx,args)=>ctx.runMutation(internal.chat._postBot,{...args,generation:0,text:"Synthetic Gaffer answer."})});
export const question=mutation({args:{accountId:v.id("accounts"),bookingId:v.id("bookings")},handler:async(ctx,args)=>postRentalMessage(ctx,{...args,sender:"renter",text:"Synthetic question",deferOwnerAlert:true})});
export const delayed=action({args:{id:v.id("gaffer_alert_jobs")},handler:async(ctx,args)=>ctx.runMutation(internal.chat.delayedGafferInquiry,args)});
export const accelerate=mutation({args:{id:v.id("gaffer_alert_jobs")},handler:async(ctx,args)=>ctx.db.patch(args.id,{dueAt:Date.now()-1})});
export const forceWatch=mutation({args:{id:v.id("gaffer_alert_jobs")},handler:async(ctx,args)=>ctx.db.patch(args.id,{checkAt:Date.now()-1})});
export const scheduled=query({args:{id:v.id("gaffer_alert_jobs")},handler:async(ctx,args)=>{const job=await ctx.db.get(args.id);return job?.scheduledId?ctx.db.system.get(job.scheduledId):null;}});
export const cancel=mutation({args:{id:v.id("gaffer_alert_jobs")},handler:async(ctx,args)=>{const job=await ctx.db.get(args.id);if(!job?.scheduledId)throw Error("Missing synthetic schedule");await ctx.scheduler.cancel(job.scheduledId);}});
export const syntheticFailure=internalMutation({args:{},handler:async()=>{throw Error("Synthetic scheduled failure");}});
export const installFailure=mutation({args:{id:v.id("gaffer_alert_jobs")},handler:async(ctx,args)=>{const scheduledId=await ctx.scheduler.runAfter(0,internal.gaffer_alert_fixture.syntheticFailure,{});await ctx.db.patch(args.id,{scheduledId});}});
export const recover=action({args:{},handler:async ctx=>ctx.runMutation(internal.chat.recoverGafferAlerts,{})});
export const seedPurge=mutation({args:{accountId:v.id("accounts"),bookingId:v.id("bookings"),renterMessageId:v.id("messages"),botMessageId:v.id("messages")},handler:async(ctx,args)=>{const old=Date.now()-31*86400000;for(const state of ["notified","skipped"] as const)for(let index=0;index<101;index++)await ctx.db.insert("gaffer_alert_jobs",{...args,generation:0,dueAt:old,completedAt:old,attempts:1,state});const review=await ctx.db.insert("gaffer_alert_jobs",{...args,generation:0,dueAt:old,completedAt:old,attempts:3,state:"review"});const recent=await ctx.db.insert("gaffer_alert_jobs",{...args,generation:0,dueAt:Date.now(),completedAt:Date.now(),attempts:1,state:"notified"});return {old,review,recent};}});
export const inspectPurge=query({args:{old:v.number(),review:v.id("gaffer_alert_jobs"),recent:v.id("gaffer_alert_jobs")},handler:async(ctx,args)=>({notified:(await ctx.db.query("gaffer_alert_jobs").withIndex("by_state_completed",q=>q.eq("state","notified").eq("completedAt",args.old)).take(110)).length,skipped:(await ctx.db.query("gaffer_alert_jobs").withIndex("by_state_completed",q=>q.eq("state","skipped").eq("completedAt",args.old)).take(110)).length,review:!!await ctx.db.get(args.review),recent:!!await ctx.db.get(args.recent)})});
export const purge=action({args:{},handler:async ctx=>ctx.runMutation(internal.chat.purgeGafferAlerts,{})});
export const inspect=query({args:{accountId:v.id("accounts"),bookingId:v.id("bookings")},handler:async(ctx,args)=>({messages:await ctx.db.query("messages").withIndex("by_booking_account_at",q=>q.eq("bookingId",args.bookingId).eq("accountId",args.accountId)).order("desc").take(20),notifications:await ctx.db.query("admin_notifications").withIndex("by_account_booking_read",q=>q.eq("accountId",args.accountId).eq("bookingId",args.bookingId)).take(20),thread:await ctx.db.query("chat_threads").withIndex("by_account_booking",q=>q.eq("accountId",args.accountId).eq("bookingId",args.bookingId)).unique(),jobs:(await ctx.db.query("gaffer_alert_jobs").withIndex("by_state_check",q=>q.eq("state","pending")).take(20)).filter(job=>job.accountId===args.accountId&&job.bookingId===args.bookingId)})});
export const inspectGeneral=query({args:{accountId:v.id("accounts")},handler:async(ctx,args)=>(await ctx.db.query("gaffer_alert_jobs").withIndex("by_state_check",q=>q.eq("state","pending")).take(20)).filter(job=>job.accountId===args.accountId&&job.bookingId===undefined)});
