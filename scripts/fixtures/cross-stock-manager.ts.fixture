import { action, mutation, query } from "./_generated/server";
import { v } from "convex/values";
import { internal } from "./_generated/api";

export const seed = mutation({ args: {}, handler: async ctx => ctx.db.insert("items", { name_canonical: "Synthetic camera", name_input: "Synthetic camera", slug: `synthetic-${Date.now()}`, kind: "camera_body", qty: 1, unit_kind: "unit", is_marketing_only: false, status: "active", created_at: 1, updated_at: 1 }) });
export const inspect = query({ args: {}, handler: async ctx => { const [claims,reservations]=await Promise.all([ctx.db.query("dbcinema_shared_stock_claims").collect(),ctx.db.query("reservations").collect()]); return { claims: claims.map(row=>({...row,requestId:row.request_id,state:row.status,holdsStock:row.holds_stock,items:row.items.map(item=>({...item,itemId:item.item_id,start:item.start,end:item.end,quantity:item.qty}))})), requests: claims.map(row=>({_id:row.request_id,state:row.status})), reservations }; } });
export const debugAcquire = action({ args: { request: v.any() }, handler: async (ctx, args) => { try { return { result: await ctx.runMutation(internal.shared_stock_authority.acquire, { source: "website", ...args.request.args }) }; } catch (error) { return { error: error instanceof Error ? error.message : String(error) }; } } });
export const reorderStoredReceipt = mutation({ args: { id: v.string() }, handler: async (ctx, args) => { const row=await ctx.db.query("dbcinema_shared_stock_claims").withIndex("by_request_id",q=>q.eq("request_id",args.id)).unique(); if(!row||row.status!=="converted"||!row.evidence_hash)throw Error("Missing synthetic converted evidence."); const evidence=JSON.parse(row.evidence_hash); await ctx.db.patch(row._id,{evidence_hash:JSON.stringify(Object.fromEntries(Object.entries(evidence).reverse()))}); } });
export const addExternal = mutation({ args: { itemId: v.id("items"), date: v.optional(v.string()) }, handler: async (ctx, args) => ctx.db.insert("reservations", { created_at: 1, status: "confirmed", account_slug: "other", hygglo_order_id: "synthetic-external-booking", start_date: args.date ?? "2031-01-01", end_date: args.date ?? "2031-01-01", resolved_items: [{ item_id: args.itemId, item_name_canonical: "Synthetic camera", confidence: 1, qty: 1 }] }) });
export const removeExternal = mutation({ args: { reservationId: v.id("reservations") }, handler: async (ctx, args) => ctx.db.delete(args.reservationId) });
export const seedOriginal = mutation({ args: { itemId: v.id("items"), bookingId: v.string(), start: v.number(), returnAt: v.number(), revision: v.optional(v.number()) }, handler: async (ctx, args) => ctx.db.insert("reservations", { created_at: 1, status: "confirmed", booking_status: "confirmed", account_slug: "dbcinema_web", hygglo_order_id: args.bookingId, order_step: "BOOKED_AFTER_VERIFIED", site_revision: args.revision ?? 3, start_date: "2031-01-01", end_date: "2031-01-01", site_item_windows: [{ item_id: args.itemId, qty: 1, start: args.start, end: args.returnAt + 3600000 }] }) });
export const convert = action({ args: { booking: v.any() }, handler: async (ctx, args) => ctx.runMutation(internal.sync_dbcinema_web.upsertSiteBookingsBatch, { bookings: [args.booking], reconcile: false }) });
