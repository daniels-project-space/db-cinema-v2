# Copy to .env.local and fill in real values. Never commit .env.local itself.

CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
VOICE_WEBHOOK_SECRET=
ELEVENLABS_API_KEY=

# Chat image uploads stay closed until a private HTTPS ClamAV scanner is
# deployed, current, and independently qualified. Set the release gate to
# "enabled" only after the scanner endpoint and bearer secret are configured.
CHAT_ATTACHMENTS_RELEASE_ENABLED=
CHAT_ATTACHMENT_SCANNER_URL=
CHAT_ATTACHMENT_SCANNER_TOKEN=

# Shared stock stays disabled unless both apps are configured and the Manager
# writer audit is complete. Use the same private secret in Manager's
# DBCINEMA_SHARED_STOCK_TOKEN setting.
SHARED_STOCK_AUTHORITY_READY=
SHARED_STOCK_BRIDGE_EXPERIMENTAL=
RMV2_WEBHOOK_URL=
SHARED_STOCK_WEBSITE_SECRET=

# Enables the no-deposit/no-hold saved-card claims policy after legal review.
SETUP_INTENT_SECURITY_POLICY_ENABLED=true

# Partner cross-link: FORM / SEVEN (Daniel's AI-native video production studio).
# The FORM / SEVEN site, used by the "Signature Productions" header overlay
# (SignatureProductionsOverlay) and the "Media Engine" nav link in SiteHeader.
#
# NOT CURRENTLY READ BY THE CODE: the live URL is hardcoded in
# SignatureProductionsOverlay.tsx. This is left here as documentation of where
# that site lives — setting it has no effect today.
#
# form7.net is the Cloudflare custom domain served by the media-engine-showcase
# worker (see its wrangler.jsonc routes).
NEXT_PUBLIC_FORM_SEVEN_URL=https://form7.net
