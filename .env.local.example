# Partner cross-link: FORM / SEVEN (Daniel's AI-native video production studio).
# Used by the "Signature Productions" header overlay (SignatureProductionsOverlay)
# and the "Media Engine" direct nav link in SiteHeader — both point at this same
# site via different interaction models (overlay preview vs. direct new-tab link).
# Until this is set, the overlay preview/link falls back to a "coming soon" state.
NEXT_PUBLIC_FORM_SEVEN_URL=https://form-seven.example.workers.dev
